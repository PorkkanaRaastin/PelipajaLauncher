{
  "name": "pelipaja",
  "version": "1.1.0",
  "description": "Pelipaja – Rasmuksen pelit yhdessä paikassa",
  "main": "app/main/index.js",
  "author": "Rasmus Rautanen",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/check.js",
    "dist": "node scripts/check.js && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fi.rautanen.pelipaja",
    "productName": "Pelipaja",
    "asar": false,
    "files": [
      "app/**/*",
      "games/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "app/assets/icon.png",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
